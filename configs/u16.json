{
  "input": "../onnx/yolo26n.onnx",
  "output_dir": "../build/u16",
  "output_name": "yolo26n_u16.axmodel",
  "model_type": "ONNX",
  "npu_mode": "NPU2",
  "quant": {
    "input_configs": [
      {
        "tensor_name": "images",
        "calibration_dataset": "../dataset/images100.tar",
        "calibration_size": 100,
        "calibration_mean": [
          0,
          0,
          0
        ],
        "calibration_std": [
          255.0,
          255.0,
          255.0
        ]
      }
    ],
    "layer_configs": [
      {
        "start_tensor_names": [
          "DEFAULT"
        ],
        "end_tensor_names": [
          "DEFAULT"
        ],
        "data_type": "U16"
      }
    ],
    "calibration_method": "MinMax",
    "precision_analysis": true,
    "precision_analysis_method": "EndToEnd"
  },
  "input_processors": [
    {
      "tensor_name": "images",
      "tensor_format": "RGB",
      "src_format": "RGB",
      "src_dtype": "U8",
      "src_layout": "NHWC"
    }
  ],
  "output_processors": [
    {
      "tensor_name": "output_split_0",
      "dst_perm": [
        0,
        2,
        3,
        1
      ]
    },
    {
      "tensor_name": "output_split_1",
      "dst_perm": [
        0,
        2,
        3,
        1
      ]
    },
    {
      "tensor_name": "output_split_2",
      "dst_perm": [
        0,
        2,
        3,
        1
      ]
    }
  ],
  "compiler": {
    "check": 0
  },
  "target_hardware": "AX620E"
}
